﻿@{
    ViewData["Title"] = "Liên Hệ";
}


<style>
   
    .contact-container {
        display: flex;
        justify-content: center; 
        padding: 4rem 1rem; 
        background-color: #f8f9fa; 
    }

    .contact-wrapper {
        display: flex;
        width: 100%;
        
        max-width: 1100px;
        background-color: #fff;
        box-shadow: 0 15px 35px rgba(0,0,0,0.1);
        border-radius: 15px;
        overflow: hidden;
    }

   
    .contact-info {
        flex: 0 0 40%;
        background-color: #ffffff;
        color: #000000;
        padding: 40px;
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

        .contact-info video {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            z-index: 1;
        }

        .contact-info .info-overlay {
            position: relative;
            z-index: 2;
            background-color: transparent;
            padding: 30px;
            border-radius: 10px;
        }

        .contact-info h3 {
            font-size: 2rem;
            margin-bottom: 1.5rem;
        }

        .contact-info p {
            margin-bottom: 1rem;
        }

        .contact-info .social-icons a {
            color: #fff;
            margin-right: 15px;
            font-size: 1.3rem;
            text-decoration: none;
        }

    
    .contact-form {
        flex: 0 0 60%;
        padding: 50px;
    }

        .contact-form .form-group {
            position: relative;
            margin-bottom: 1.5rem;
        }

        .contact-form .form-control {
            border-radius: 5px;
            padding-left: 40px;
        }

        .contact-form .input-icon {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #6c757d;
        }

</style>


<div class="contact-container">
    <div class="contact-wrapper">
       
        <div class="contact-info">
            <video loop autoplay muted playsinline>
                <source src="~/assets/images/contact-video.mp4" type="video/mp4">
                Trình duyệt của bạn không hỗ trợ thẻ video.
            </video>
            <div class="info-overlay">
                <h3 class="fw-bold">Thông tin liên hệ</h3>
                <p><i class="bi bi-telephone-fill me-2"></i><strong>Hotline:</strong> 0961321851</p>
                <p><i class="bi bi-geo-alt-fill me-2"></i><strong>Địa chỉ:</strong>Phường8,Đà Lạt,Lâm Đồng</p>
                <p><i class="bi bi-envelope-fill me-2"></i><strong>Email:</strong>huuthaohk@gmail.com</p>
                <div class="social-icons mt-4">
                    <a href="#"><i class="bi bi-facebook"></i></a>
                    <a href="#"><i class="bi bi-twitter"></i></a>
                    <a href="#"><i class="bi bi-youtube"></i></a>
                </div>
            </div>
        </div>

        
        <div class="contact-form">
            <h2 class="text-center mb-4">Gửi tin nhắn cho chúng tôi</h2>
            <form action="#" method="post">
                <div class="form-group">
                    <i class="bi bi-person input-icon"></i>
                    <input type="text" class="form-control" placeholder="Tên đầy đủ của bạn (*)" required>
                </div>
                <div class="form-group">
                    <i class="bi bi-envelope input-icon"></i>
                    <input type="email" class="form-control" placeholder="Email (*)" required>
                </div>
                <div class="form-group">
                    <i class="bi bi-pencil-square input-icon" style="top: 25px; align-self: flex-start;"></i>
                    <textarea class="form-control" rows="5" placeholder="Nội dung liên hệ"></textarea>
                </div>
                <div class="text-end">
                    <button type="submit" class="btn btn-primary">Gửi</button>
                </div>
            </form>
        </div>
    </div>
</div>