@model IEnumerable<GameShop.Models.Product>
<section data-bs-version="5.1" class="header18 cid-tsEQyIZRcx mbr-fullscreen mbr-parallax-background"
         id="header18-1">
    <div class="mbr-overlay"
         style="opacity:0.9; background-image: url('https://th.bing.com/th/id/R.fb20aa2c1b26acb590d2334b9ca68be1?rik=6r0OIur4mDCXrg&pid=ImgRaw&r=0');">
    </div>
    <div class="mbr-overlay" style="opacity: 0.7; background-color: rgb(0, 0, 0);"></div>
    <div class="align-center container">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-10">
                <h1 class="mbr-section-title mbr-fonts-style mbr-white mb-3 display-1">
                    <strong>
                        Chào Mừng Đến Với Thế Giới Game Của Chúng Tôi
                    </strong>
                </h1>

                <p class="mbr-text mbr-fonts-style mbr-white display-7">
                    Khởi Nguồn Của Đam Mê
                </p>
                <div class="mbr-section-btn mt-3">
                    <a asp-controller="Products" asp-action="Shop" class="btn btn-black display-4">
                        <span class="mobi-mbri mobi-mbri-shopping-bag mbr-iconfont mbr-iconfont-btn"></span>Cửa Hàng&nbsp;
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
<section class="content2 cid-tsEQSCqggh" id="content2-2">
    <div class="container">
        <div class="mbr-section-head">
            <h4 class="mbr-section-title align-center mb-0 display-2">
                <strong>Sản Phẩm Nổi Bật</strong>
            </h4>
            <h5 class="mbr-section-subtitle align-center mt-2 display-5">
                Những sản phẩm được yêu thích nhất từ kho game.
            </h5>
        </div>
        <partial name="_Product" model="Model" />
    </div>
</section>
