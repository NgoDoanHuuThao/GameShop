@model GameShop.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Đăng Nhập";
}

<div class="container mt-5" style="max-width: 400px;">
    <h2 class="text-center mb-4">Đăng Nhập</h2>
    <p class="text-center text-muted">Chào Mừng Đến Với Game Shop.</p>

    <form asp-action="Login" method="post">
        <div class="form-group mb-3">
            <label asp-for="Email" class="form-label">Email</label>
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="Password" class="form-label">Mật khẩu</label>
            <input asp-for="Password" class="form-control" type="password" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="form-check mb-3">
            <input asp-for="RememberMe" class="form-check-input" />
            <label asp-for="RememberMe" class="form-check-label">Ghi nhớ đăng nhập?</label>
        </div>

        <button type="submit" class="btn w-100" style="background-color: white; color: black; border: 1px solid black;">Đăng Nhập</button>

        <div class="mt-3 text-center">
            <a asp-action="ForgotPassword" class="d-block">Quên mật khẩu?</a>
            <a asp-action="Register" class="d-block">Đăng ký tài khoản mới</a>
            <a asp-action="ResendEmailConfirmation" class="d-block">Gửi lại email xác nhận</a>
        </div>
    </form>
</div>
