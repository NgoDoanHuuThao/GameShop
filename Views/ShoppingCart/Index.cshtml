@model List<GameShop.Models.ShoppingCartItem>
<section class="h-100 h-custom">
    <div class="container py-5 h-100">
        <div class="row d-flex justify-content-center align-items-center h-100">
            <div class="col">
                <div class="card">
                    <div class="card-body p-4">

                        <div class="row">
                            <div class="col-lg-7">
                                <h5 class="mb-3">
                                    <a asp-controller="Products" asp-action="Shop" class="text-body">
                                        <i class="fas fa-long-arrow-alt-left me-2"></i>Tiếp tục mua sắm
                                    </a>
                                </h5>
                                <hr />

                                @foreach (var item in Model)
                                {
                                    <div class="row mb-4 d-flex justify-content-between align-items-center">
                                        <div class="col-md-2 col-lg-2 col-xl-2">
                                            <img src="@item.Product.ImageUrl" class="img-fluid rounded-3" alt="" />
                                        </div>
                                        <div class="col-md-3 col-lg-3 col-xl-3">
                                            <div class="d-flex align-items-center">
    <form asp-action="IncreaseQuantity" asp-route-id="@item.Product.Id" method="post" class="me-2">
        <button type="submit" class="btn btn-outline-light btn-sm text-white border-white">+</button>
    </form>

    <span class="mx-2">@item.Quantity</span>
</div>

<small class="text-muted">@item.Product.Name</small>
                                        </div>
                                        <div class="col-md-3 col-lg-2 col-xl-2 offset-lg-1">
                                            <h6 class="mb-0">@($"{item.Product.Price * item.Quantity:C}")</h6>
                                        </div>
                                        <div class="col-md-1 col-lg-1 col-xl-1 text-end">
                                            <a asp-action="RemoveFromCart" asp-route-id="@item.Product.Id" class="text-decoration-none">
                                                <h3>&#128465;</h3> <!-- Biểu tượng thùng rác -->
                                            </a>
                                        </div>
                                    </div>
                                    <hr class="my-4" />
                                }
                            </div>

                            <div class="col-lg-5 bg-grey">
                                <div class="p-5">
                                    <h4 class="fw-bold mb-5 mt-2 pt-1">Tổng kết</h4>
                                    <hr class="my-4" />
                                    <div class="d-flex justify-content-between mb-5">
                                        <h5 class="text-uppercase">Tổng tiền</h5>
                                        <h5>
                                            @($"{Model.Sum(i => i.Product.Price * i.Quantity):C}")
                                        </h5>
                                    </div>
                                    <a>
                                        <form asp-controller="Order" asp-action="Checkout" method="get">
    <button type="submit" class="btn btn-dark text-white w-100 text-center">
        Thanh toán
    </button>
</form>
                                    </a>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
